{
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9999",
      "secret": "test"
    }
  },
  "log": { "level": "error" },
  "dns": {
    "independent_cache": true,
    "servers": [
      { "tag": "dns-direct", "type": "udp", "server": "1.1.1.1" },
      { "tag": "dns-fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15" }
    ],
    "rules": [
      {
        "domain": ["example.com"],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "domain": ["www.google.com", "google.com"],
        "action": "route",
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-direct"
  },
  "inbounds": [],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy-0",
      "server": "example.com",
      "server_port": 443,
      "uuid": "11111111-1111-1111-1111-111111111111",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "domain_resolver": {
        "server": "dns-direct"
      }
    },
    {
      "type": "urltest",
      "tag": "urltest-ping",
      "outbounds": ["proxy-0"],
      "url": "https://www.google.com/generate_204",
      "interval": "10m"
    },
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct"
    },
    "final": "direct"
  }
}
